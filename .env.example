# =============================================================================
# AI Tech Pulse Digest — Environment Variables Configuration
# =============================================================================

# Server Configuration
PORT=8080

# PostgreSQL Database with pgvector
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aitechpulse?sslmode=disable

# Google Gemini API
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Telegram Bot API
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Daily Cron Schedule (Standard 5-spec: Minute Hour DayOfMonth Month DayOfWeek)
# Default: Daily at 08:00 AM UTC
CRON_SCHEDULE=0 8 * * *

# Pipeline Execution Settings
RUN_PIPELINE_ON_STARTUP=false
WORKER_COUNT=3
QUEUE_BUFFER_SIZE=100
TOP_ARTICLES_LIMIT=5
